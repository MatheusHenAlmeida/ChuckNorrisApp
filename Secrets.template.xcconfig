//
//  This is a template file for configuring sensitive keys.
//  Duplicate this file and rename it to "Secrets.xcconfig" in the root directory.
//  Secrets.xcconfig is ignored by Git to prevent leaking credentials.
//

// Google AdMob Application ID (e.g. ca-app-pub-3940256099942544~1458002511 for testing)
AD_APP_ID = YOUR_ADMOB_APP_ID_HERE

// Google AdMob Ad Unit ID for Banners (e.g. ca-app-pub-3940256099942544/2934735716 for testing)
AD_UNIT_ID = YOUR_ADMOB_UNIT_ID_HERE
